# AsyncFlow Platform Environment Variables

APP_ENV="development"
APP_SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
DATABASE_URL="postgresql+psycopg://asyncflow:password@localhost:5432/asyncflow"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
FRONTEND_ORIGIN="http://localhost:3000"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_BACKEND="local_storage"
LOCAL_STORAGE_PATH="./storage/results"
LOG_LEVEL="INFO"
TASK_DEFAULT_TIMEOUT=300
TASK_MAX_RETRIES=3
TASK_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=50

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
